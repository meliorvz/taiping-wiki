{
  "name": "taiping-wiki",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "node scripts/generate-content.mjs",
    "dev": "vinext dev",
    "prebuild": "node scripts/generate-content.mjs",
    "build": "vinext build",
    "deploy:cloudflare": "wrangler deploy --domain taiping.vzfz.me",
    "deploy:cloudflare:dry-run": "wrangler deploy --domain taiping.vzfz.me --dry-run",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.4.1",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.37",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.1",
    "react-server-dom-webpack": "19.2.9",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "undici": "7.29.0",
    "vinext": "1.2.0",
    "vite": "8.0.13",
    "wrangler": "4.142.0"
  },
  "type": "module"
}
